<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/input_bg_focused"/>
            <corners android:radius="28dp"/>
            <stroke
                android:width="2dp"
                android:color="@color/input_border_focused"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/input_bg_transparent"/>
            <corners android:radius="28dp"/>
            <stroke
                android:width="1.5dp"
                android:color="@color/input_border_normal"/>
        </shape>
    </item>
</selector>
